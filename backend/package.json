{
  "name": "backend",
  "version": "0.1.0",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/src/main",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "format": "prettier --write .",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "coverage:unit": "jest --coverage --coverageDirectory=../coverage-unit --coverageReporters=json --collectCoverageFrom=\"**/*.ts\" --collectCoverageFrom=\"!**/*.spec.ts\" --collectCoverageFrom=\"!**/*.module.ts\" --collectCoverageFrom=\"!**/index.ts\" --collectCoverageFrom=\"!**/interfaces/**\" --collectCoverageFrom=\"!**/entities/**\" --collectCoverageFrom=\"!database/migrations/**\" --collectCoverageFrom=\"!database/seeds/**\" --collectCoverageFrom=\"!main.ts\"",
    "coverage:e2e": "jest --config test/e2e/jest-e2e.json --runInBand --coverage --coverageDirectory=coverage-e2e --coverageReporters=json --collectCoverageFrom=\"src/**/*.ts\" --collectCoverageFrom=\"!src/**/*.spec.ts\" --collectCoverageFrom=\"!src/**/*.module.ts\" --collectCoverageFrom=\"!src/**/index.ts\" --collectCoverageFrom=\"!src/**/interfaces/**\" --collectCoverageFrom=\"!src/**/entities/**\" --collectCoverageFrom=\"!src/database/migrations/**\" --collectCoverageFrom=\"!src/database/seeds/**\" --collectCoverageFrom=\"!src/main.ts\"",
    "coverage:integration": "jest --config test/integration/jest-integration.json --runInBand --coverage --coverageDirectory=coverage-integration --coverageReporters=json --collectCoverageFrom=\"src/**/*.ts\" --collectCoverageFrom=\"!src/**/*.spec.ts\" --collectCoverageFrom=\"!src/**/*.module.ts\" --collectCoverageFrom=\"!src/**/index.ts\" --collectCoverageFrom=\"!src/**/interfaces/**\" --collectCoverageFrom=\"!src/**/entities/**\" --collectCoverageFrom=\"!src/database/migrations/**\" --collectCoverageFrom=\"!src/database/seeds/**\" --collectCoverageFrom=\"!src/main.ts\"",
    "test:coverage:all": "pnpm coverage:unit && pnpm coverage:e2e && pnpm coverage:integration && node test/helpers/merge-coverage.js",
    "test:e2e": "jest --config test/e2e/jest-e2e.json",
    "test:integration": "ts-node test/helpers/report-integration-environment.ts && jest --config test/integration/jest-integration.json --runInBand",
    "openapi:generate": "nest build && node dist/src/openapi/generate-openapi.js",
    "openapi:lint": "pnpm openapi:generate && redocly lint dist/openapi.json",
    "test:ci": "pnpm lint && pnpm test:coverage --runInBand && pnpm test:e2e --runInBand && pnpm test:integration && pnpm db:check && pnpm build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:local": "ts-node src/database/migrate.ts",
    "db:check": "drizzle-kit check",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@fastify/compress": "^9.1.0",
    "@fastify/multipart": "^10.1.0",
    "@fastify/static": "^10.1.2",
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.28",
    "@nestjs/platform-fastify": "^11.1.28",
    "@nestjs/swagger": "^11.4.6",
    "@nestjs/throttler": "^6.5.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.10.0",
    "pg": "^8.22.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.1.28",
    "@redocly/cli": "2.45.0",
    "@types/jest": "30.0.0",
    "@types/node": "^26.1.2",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.8.0",
    "jest": "^30.4.2",
    "prettier": "^3.0.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "^5.0.0"
  },
  "pnpm": {
    "overrides": {
      "fast-uri@<3.1.5": "3.1.5",
      "fast-uri@>=4.0.0 <4.1.2": "4.1.2",
      "brace-expansion@>=4.0.0 <5.0.9": "5.0.9",
      "find-my-way@<9.7.0": "9.7.0",
      "js-yaml@>=5.0.0 <5.2.2": "5.2.2"
    }
  }
}
