# Docker Compose settings. Copy to .env next to the compose files; Compose reads it for ${...}
# substitution. Application settings live in backend/.env and frontend/.env instead.

# ── Local development (docker-compose.yml) ─────────────────────
# Must match DATABASE_URL in backend/.env.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=appdb
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin

# ── Production (docker-compose.prod.yml) ───────────────────────
DOMAIN=example.org
ACME_EMAIL=ops@example.org
IMAGE_OWNER=nehemiah-autism-center
IMAGE_TAG=latest
# htpasswd entries for the Traefik dashboard and Dozzle, e.g. from `htpasswd -nB admin`.
# Keep the single quotes: they stop Compose from expanding the $ signs in the hash.
OPS_BASIC_AUTH_USERS='admin:$2y$05$REPLACE_WITH_A_BCRYPT_HASH'
