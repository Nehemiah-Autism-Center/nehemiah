NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NODE_ENV=development

# Public origin of the site (canonical links, hreflang, sitemap, Open Graph). Set per environment.
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Release switches (build-time):
# NEXT_PUBLIC_HIDE_PENDING_TESTIMONIALS=true   # withhold testimonials awaiting approval
# NEXT_PUBLIC_HIDE_PROVISIONAL_AMHARIC=true    # show English instead of unreviewed Amharic labels

# Local production builds on Windows without Developer Mode (cannot create symlinks):
# NEXT_STANDALONE=0
